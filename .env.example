# Only the bot token and administrator list are needed. Everything else is set in Telegram.
# Never commit the real .env. Restrict permissions with chmod 600 .env.
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ADMIN_IDS=123456789,987654321
# Existing installations may continue using TELEGRAM_ADMIN_ID for one admin.
# If both settings exist, TELEGRAM_ADMIN_IDS takes precedence.
